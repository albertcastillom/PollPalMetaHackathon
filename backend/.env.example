PORT=3001
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_SSL=false
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=copy-from-supabase-status
UNSUBSCRIBE_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Meta Model API (Muse Spark) for candidate comparisons and translation. Server-side only.
MODEL_API_KEY=
MUSE_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
# Demo mode (on unless set to false): treat DEMO_DATE as today so the Nov 3, 2026 election
# still shows as upcoming, and give addresses outside Washington clearly labeled sample data.
DEMO_MODE=true
DEMO_DATE=2026-10-27
