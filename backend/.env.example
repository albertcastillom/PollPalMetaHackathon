PORT=3001
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_SSL=false
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=copy-from-supabase-status
UNSUBSCRIBE_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Meta NLLB-200 translation through Hugging Face Inference Providers.
# Create a token with "Inference Providers" permission. Translation remains
# disabled (and the frontend falls back to English) when HF_TOKEN is empty.
HF_TOKEN=
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_API_URL=https://router.huggingface.co/hf-inference/models
