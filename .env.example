# Frontend environment variables (Vite).
# Copy this file to .env.local and fill in the values, then restart `npm run dev`.
# Everything here is bundled into the browser, so only put public/publishable values here.
# Never add DATABASE_URL, a Supabase secret/service_role key, or other backend secrets.

# PollPal backend API (see backend/.env.example). Defaults to http://localhost:3001.
VITE_API_URL=http://localhost:3001

# Supabase project used for login, profiles, friends, and reminder settings.
# Local: run `npx supabase status` and use the API URL and publishable (anon) key.
# Hosted: Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mapbox public access token (starts with pk.) for the ballot drop-off map.
# Create one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
